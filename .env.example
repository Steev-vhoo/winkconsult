# Postgres connection string. On Vercel, connect a Neon database (Project -> Storage) and this
# is added for you, along with DATABASE_URL_UNPOOLED (used for schema changes during builds).
# Locally: any Postgres, or copy the connection string from the Neon console.
DATABASE_URL=postgres://postgres:password@localhost:5432/wink

# Long random string used to hash visitor IPs for spam protection. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# First admin account: created automatically on deploy if there are no accounts yet
# (or run `npm run admin:create`). You can remove these once you've signed in.
# Public address of the site, used for the sitemap and link previews.
SITE_URL=https://www.example.com

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email alerts for new enquiries (https://resend.com, free tier).
# EMAIL_FROM must use a domain you've verified in Resend, e.g. "WiNK Website <alerts@winkconsult.com>".
# Until a domain is verified, Resend only delivers from onboarding@resend.dev to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=
# Optional fallback recipients (comma-separated) if none are set in Admin -> Site settings.
NOTIFY_TO=

# Image uploads (Vercel Blob). On Vercel, connect a Blob store (Project -> Storage) and this is added for you.
BLOB_READ_WRITE_TOKEN=
