# MongoDB connection string (MongoDB Atlas: Connect -> Drivers), e.g.
# mongodb+srv://wink-app:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster (optional, defaults to "wink").
MONGODB_DB=wink

# Long random string used to hash visitor IPs for spam protection. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# Used once by `npm run admin:create` to create the first admin account.
# Public address of the site, used for the sitemap and link previews.
SITE_URL=https://www.example.com

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email alerts for new enquiries (https://resend.com, free tier).
# EMAIL_FROM must use a domain you've verified in Resend, e.g. "WiNK Website <alerts@winkconsult.com>".
# Until a domain is verified, Resend only delivers from onboarding@resend.dev to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=
# Optional fallback recipients (comma-separated) if none are set in Admin -> Site settings.
NOTIFY_TO=
